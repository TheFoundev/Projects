{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "build/test",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/sha256.ts",
    "src/address.ts",
    "src/wallet-core.ts",
    "src/store.ts",
    "test/**/*.ts"
  ]
}
