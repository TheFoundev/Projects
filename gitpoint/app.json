{
  "expo": {
    "name": "GitPoint",
    "slug": "gitpoint",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foundev.gitpoint"
    },
    "android": {
      "package": "com.foundev.gitpoint",
      "adaptiveIcon": {
        "backgroundColor": "#24292f"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
