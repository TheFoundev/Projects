# API key for the OpenAI-compatible endpoint used by the chat model
# (OpenRouter: https://openrouter.ai/keys | Groq: https://console.groq.com/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: site metadata sent to the provider
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=College FAQ Chatbot

# Branding — set these to your institution
INSTITUTION_NAME=Your College
APP_TITLE=FAQ Chatbot

# OpenAI-compatible base URL (defaults to OpenRouter)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=https://api.groq.com/openai/v1

# Model configuration
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

# Embedding backend
#   openai -> remote embeddings endpoint (needs an API key that serves /embeddings)
#   local  -> local ONNX model via fastembed (no API key needed)
EMBEDDING_PROVIDER=openai
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval tuning
RETRIEVAL_TOP_K=5
RELEVANCE_SCORE_THRESHOLD=0.20
FETCH_K=20
LAMBDA_MULT=0.5
ADAPTIVE_K_THRESHOLD=0.45

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Query pipeline
ENABLE_QUERY_REWRITING=true
