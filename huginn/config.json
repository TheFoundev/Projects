{
  "name": "Huginn",
  "tagline": "Agents that watch the web for you",
  "description": "Automation platform of agents that watch events, monitor websites and trigger actions such as alerts, posts or API calls.",
  "special": "automation",
  "features": [
    "Agents with HTTP check, webhook and digest behaviours",
    "Manual run button with recorded latency and outcome",
    "Event stream of everything an agent observed",
    "Run history with error messages",
    "Schedules and status stored alongside each agent"
  ],
  "publicRead": true,
  "port": 3000,
  "resources": [
    {
      "name": "agents",
      "label": "Agents",
      "icon": "\u25ce",
      "fields": [
        {
          "name": "name",
          "required": true,
          "type": "text",
          "label": "Name"
        },
        {
          "name": "kind",
          "required": true,
          "options": [
            "http_check",
            "webhook",
            "digest"
          ],
          "default": "http_check",
          "type": "text",
          "label": "Kind"
        },
        {
          "name": "schedule",
          "default": "every 15 minutes",
          "type": "text",
          "label": "Schedule"
        },
        {
          "name": "config",
          "multiline": true,
          "label": "Target URL / config",
          "type": "text"
        },
        {
          "name": "status",
          "default": "active",
          "type": "text",
          "label": "Status"
        },
        {
          "name": "last_run",
          "type": "text",
          "label": "Last Run"
        }
      ]
    },
    {
      "name": "events",
      "label": "Events",
      "icon": "\u25c8",
      "fields": [
        {
          "name": "agent_id",
          "type": "int",
          "label": "Agent ID"
        },
        {
          "name": "title",
          "required": true,
          "type": "text",
          "label": "Title"
        },
        {
          "name": "payload",
          "multiline": true,
          "type": "text",
          "label": "Payload"
        },
        {
          "name": "status",
          "default": "new",
          "type": "text",
          "label": "Status"
        }
      ]
    },
    {
      "name": "runs",
      "label": "Runs",
      "icon": "\u25a4",
      "fields": [
        {
          "name": "agent_id",
          "type": "int",
          "label": "Agent ID"
        },
        {
          "name": "status",
          "default": "ok",
          "type": "text",
          "label": "Status"
        },
        {
          "name": "message",
          "multiline": true,
          "type": "text",
          "label": "Message"
        },
        {
          "name": "duration_ms",
          "type": "int",
          "default": 0,
          "label": "Duration Ms"
        }
      ]
    }
  ],
  "seed": {
    "agents": [
      {
        "name": "Status page watch",
        "kind": "http_check",
        "schedule": "every 5 minutes",
        "config": "https://example.com",
        "status": "active",
        "last_run": ""
      },
      {
        "name": "Release webhook",
        "kind": "webhook",
        "schedule": "on demand",
        "config": "https://example.com/hooks/release",
        "status": "active",
        "last_run": ""
      },
      {
        "name": "Daily digest",
        "kind": "digest",
        "schedule": "daily at 08:00",
        "config": "summary",
        "status": "active",
        "last_run": ""
      }
    ],
    "events": [
      {
        "agent_id": 1,
        "title": "example.com responded 200",
        "payload": "Initial manual check",
        "status": "ok"
      },
      {
        "agent_id": 3,
        "title": "Digest queued",
        "payload": "Waiting for the next scheduled window",
        "status": "new"
      }
    ]
  }
}
